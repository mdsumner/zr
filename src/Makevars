TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libzr.a
PKG_LIBS = -L$(LIBDIR) -lzr

# Set ZR_FEATURES=remote to enable HTTP/S3 stores (requires OpenSSL)
# Default: local only (no tokio/openssl/reqwest)
ZR_CARGO_FEATURES =
ifneq ($(ZR_FEATURES),)
	ZR_CARGO_FEATURES = --features $(ZR_FEATURES)
endif

all: C_clean

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo

$(STATLIB):
	if [ "$(NOT_CRAN)" != "true" ]; then \
		export CARGO_HOME=$(CARGOTMP); \
	fi && \
		export PATH="$(HOME)/.cargo/bin:$(PATH)" && \
		cargo build --lib --release --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) $(ZR_CARGO_FEATURES)
	if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf $(CARGOTMP) && \
		rm -Rf $(LIBDIR)/build; \
	fi

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target
